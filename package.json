{
  "name": "nibble",
  "private": true,
  "type": "module",
  "workspaces": ["nibble-sdk", "nibble-engine", "example", "scripts", "tests"],
  "scripts": {
    "start": "bun run --cwd nibble-engine start",
    "build": "bun scripts/build.ts",
    "build:engine": "bun scripts/build-engine.ts",
    "build:router": "bun scripts/build-router.ts",
    "build:daemon": "bun scripts/build-daemon.ts",
    "build:sdk": "bun scripts/build-sdk.ts",
    "test:integration": "bun run build && bun test ./tests/daemon.integration.ts",
    "proto": "bun scripts/proto.ts",
    "typecheck": "tsc -b nibble-sdk nibble-engine example scripts tests",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
