{
  "name": "nibble",
  "private": true,
  "type": "module",
  "workspaces": ["nibble-sdk", "nibble-engine"],
  "scripts": {
    "start": "bun run --cwd nibble-engine start",
    "build": "bun scripts/build.ts",
    "build:router": "bun scripts/build-router.ts",
    "proto": "bun scripts/proto.ts",
    "typecheck": "tsc -b nibble-sdk nibble-engine scripts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@lucap9056/nibble": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
